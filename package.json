{
  "name": "aviala-website",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:colorcat": "npm run dev -w @aviala/colorcat",
    "build:colorcat": "npm run build -w @aviala/colorcat",
    "dev:spiral-docs": "npm run dev -w @aviala/spiral-docs",
    "dev:spiral-docs:local": "node apps/spiral-docs/scripts/with-local-spiral.mjs npm run dev -w @aviala/spiral-docs",
    "build:spiral-docs": "npm run build -w @aviala/spiral-docs",
    "dev:design-guide-editor": "npm run dev -w @aviala/design-guide-editor",
    "dev:design-guide-editor:local": "node apps/spiral-docs/scripts/with-local-spiral.mjs npm run dev -w @aviala/design-guide-editor",
    "dev:hugo": "hugo server -D --bind 127.0.0.1 --port 1313 --disableFastRender",
    "dev:site": "npx --yes concurrently -k -n vite,hugo -c cyan,magenta \"npm run dev:spiral-docs\" \"npm run dev:hugo\"",
    "dev:site:local": "node apps/spiral-docs/scripts/with-local-spiral.mjs npx --yes concurrently -k -n vite,hugo -c cyan,magenta \"npm run dev -w @aviala/spiral-docs\" \"npm run dev:hugo\""
  },
  "version": "1.0.0",
  "description": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AvialaOSS/avialaWebsite.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/AvialaOSS/avialaWebsite/issues"
  },
  "homepage": "https://github.com/AvialaOSS/avialaWebsite#readme"
}
